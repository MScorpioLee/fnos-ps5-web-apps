+"""Full streaming page in Chromium; replace only remote connection/media transport."""
+import asyncio
+import json
+import os
+from pathlib import Path
+
+from playwright.async_api import async_playwright, expect
+
+BASE = os.environ.get('PSRP_FIXTURE_BASE', 'http://127.0.0.1:5197/app/psrp-web/')
+OUT = Path(os.environ['PSRP_SCREENSHOTS']) if 'PSRP_SCREENSHOTS' in os.environ else None
+HTML = '''<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<div id="root"></div><script type="module">
+import RefreshRuntime from './@react-refresh'; RefreshRuntime.injectIntoGlobalHook(window);
+window.$RefreshReg$=()=>{};window.$RefreshSig$=()=>type=>type;window.__vite_plugin_react_preamble_installed__=true;
+await import('./tests/fullscreen-harness.tsx');</script>'''
+STUB = '''export function useStreamingConnection() { return {
+  isConnected:true, isConnecting:false, connectionState:'connected', connect:()=>{},
+  disconnect:()=>window.actions.push('disconnect'), endRemoteSession:async()=>window.actions.push('end'),
+  connectionStats:{}, isStatsMonitoringEnabled:false, setStatsMonitoring:()=>window.actions.push('stats'),
+  webrtcSessionId:null, isStalling:false, bufferMode:'auto', bufferResults:[], chooseBufferMode:()=>{}
+} }'''
+PLAY = '''async ([width,height])=>{
+  const video=document.querySelector('video'), canvas=document.createElement('canvas');
+  canvas.width=width;canvas.height=height;
+  const ctx=canvas.getContext('2d');
+  const g=ctx.createLinearGradient(0,0,width,height);
+  g.addColorStop(0,'#017c88');g.addColorStop(1,'#602a99');
+  ctx.fillStyle=g;ctx.fillRect(0,0,width,height);
+  ctx.strokeStyle='#67e8f9';ctx.lineWidth=8;ctx.strokeRect(4,4,width-8,height-8);
+  ctx.textAlign='center';ctx.fillStyle='white';ctx.font='bold 32px sans-serif';
+  ctx.fillText('Synthetic game frame',width/2,height/2);
+  ctx.font='18px sans-serif';ctx.fillText(`${width} × ${height} · browser video fixture`,width/2,height/2+26);
+  clearInterval(window.fixtureTimer);
+  video.srcObject?.getTracks().forEach(track=>track.stop());
+  video.srcObject=canvas.captureStream(30);
+  window.fixtureTimer=setInterval(()=>ctx.fillRect(8,8,1,1),40);
+  await video.play();
+  await Promise.race([new Promise(resolve=>video.requestVideoFrameCallback(resolve)),
+    new Promise((_,reject)=>setTimeout(()=>reject(new Error('No video frame presented')),3000))]);
+  window.fixtureVideo ??= video;
+}'''
+MEASURE = '''()=>{
+  const v=document.querySelector('video'), b=v.getBoundingClientRect();
+  const box=r=>[r.left,r.top,r.width,r.height];
+  const scale=Math.min(b.width/v.videoWidth,b.height/v.videoHeight);
+  const w=v.videoWidth*scale,h=v.videoHeight*scale;
+  const measure=el=>{const r=el.getBoundingClientRect();
+    const x=r.left+r.width/2,y=r.top+r.height/2;
+    const target=document.elementFromPoint(x,y);
+    const owner=target?.closest('button, summary, [data-control]');
+    return {name:el.dataset.control||el.getAttribute('aria-label')||el.textContent.trim(),
+      rect:box(r),hit:el.contains(target),hitOwner:owner?.dataset.control||owner?.getAttribute('aria-label')||owner?.textContent.trim(),opacity:getComputedStyle(el).opacity};};
+  return {video:box(b),image:[b.left+(b.width-w)/2,b.top+(b.height-h)/2,w,h],
+    fit:getComputedStyle(v).objectFit,position:getComputedStyle(v).objectPosition,
+    intrinsic:[v.videoWidth,v.videoHeight],same:v===window.fixtureVideo,playing:!v.paused,
+    controls:[...document.querySelectorAll('[data-control]')].map(measure),
+    hud:[...document.querySelectorAll('details[aria-label="串流诊断"]>summary, button[aria-label$="全屏"], button[aria-label$="触屏手柄"], button[aria-controls="streaming-actions"], #streaming-actions button, .fullscreen-container>button:not([aria-label])')].filter(el=>el.checkVisibility()).map(measure)};
+}'''
+
+
+SETTLE = '()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)))'
+
+
+def contains(outer, inner, tolerance=1):
+    x,y,w,h = outer
+    a,b,c,d = inner
+    return a >= x-tolerance and b >= y-tolerance and a+c <= x+w+tolerance and b+d <= y+h+tolerance
+
+
+def overlaps(a, b):
+    return min(a[0]+a[2],b[0]+b[2])-max(a[0],b[0]) > .5 and min(a[1]+a[3],b[1]+b[3])-max(a[1],b[1]) > .5
+
+
+async def hit_cases(page, cases):
+    failures = []
+    menu = page.locator('button[aria-controls="streaming-actions"]')
+    surface = page.locator('[data-touch-layout]')
+    for width,height,iw,ih in cases:
+        await page.set_viewport_size({'width':width,'height':height})
+        await page.evaluate(PLAY, [iw,ih])
+        initial = await page.evaluate(MEASURE)
+        for fullscreen in (False, True):
+            if fullscreen:
+                await page.get_by_role('button',name='全屏',exact=True).tap()
+                await expect(page.get_by_role('button',name='退出全屏',exact=True)).to_be_enabled()
+                assert await page.evaluate('document.fullscreenElement?.classList.contains("fullscreen-container")')
+            # Match the reviewed state first, then check the other menu state as well.
+            for opened in ((False,True) if height==160 else (True,False)):
+                if opened:
+                    await menu.tap()
+                    await expect(menu).to_have_attribute('aria-expanded','true')
+                name = f'{width}x{height}-{iw}x{ih}-{"full" if fullscreen else "window"}-{"open" if opened else "closed"}'
+                await page.evaluate(SETTLE)
+                on = await page.evaluate(MEASURE)
+                await page.get_by_role('button',name='隐藏触屏手柄',exact=True).tap()
+                await expect(surface).to_have_count(0)
+                await page.evaluate(SETTLE)
+                off = await page.evaluate(MEASURE)
+                await page.get_by_role('button',name='显示触屏手柄',exact=True).tap()
+                await expect(surface).to_be_visible()
+                await page.evaluate(SETTLE)
+                again = await page.evaluate(MEASURE)
+                assert not off['controls']
+                assert all(s['same'] and s['playing'] and s['intrinsic']==[iw,ih] and
+                           s['image']==initial['image'] and s['video']==initial['video'] for s in (on,off,again)), name
+                assert len(on['controls']) == len(again['controls']) == 19
+                assert all(len(s['hud']) == (7 if opened else 5) for s in (on,off,again))
+                issues = set()
+                for s in (on,off,again):
+                    targets = s['controls'] + s['hud']
+                    for i,a in enumerate(targets):
+                        r = a['rect']
+                        if not a['hit']:
+                            issues.add(f'{a["name"]} center hit {a.get("hitOwner")}')
+                        game = a in s['controls']
+                        bounds = s['image'] if game else [0,0,width,height]
+                        minimum = 12 if game else 44
+                        if min(r[2:]) < minimum or not contains(bounds,r):
+                            issues.add(f'{a["name"]} outside bounds or too small: {r}')
+                        for b in targets[i+1:]:
+                            if overlaps(r,b['rect']):
+                                issues.add(f'{a["name"]} overlaps {b["name"]}')
+                if OUT:
+                    await page.screenshot(path=OUT/f'{name}.png', animations='disabled')
+                print(json.dumps({'case':name,'image':on['image'],'minGameSide':min(min(a['rect'][2:]) for a in on['controls']),
+                                  'issues':sorted(issues)},ensure_ascii=False),flush=True)
+                failures.extend((name,issue) for issue in issues)
+                if opened:
+                    await menu.tap()
+                    await expect(menu).to_have_attribute('aria-expanded','false')
+            if fullscreen:
+                await page.get_by_role('button',name='退出全屏',exact=True).tap()
+                await expect(page.get_by_role('button',name='全屏',exact=True)).to_be_enabled()
+                assert not await page.evaluate('!!document.fullscreenElement')
+    return failures
+
+
+async def main():
+    failures = []
+    async with async_playwright() as pw:
+        browser = await pw.chromium.launch(executable_path=os.environ.get('PSRP_CHROME'), args=['--no-sandbox'])
+        print('Chromium', browser.version, flush=True)
+        hit_only = os.environ.get('PSRP_HIT_CASES') == '1'
+        matrix = [(True, [(400,401,640,480),(320,200,640,360),(844,160,640,360)])] if hit_only else [
+            (True, [(390,844,640,360),(844,390,640,360),(320,568,640,360),(667,320,640,480)]),
+            (False, [(1280,720,640,360),(390,844,640,360)])]
+        for mobile, cases in matrix:
+            page = await browser.new_page(has_touch=True, is_mobile=mobile, user_agent=(
+                'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148 Safari/604.1' if mobile else None),
+                viewport={'width':cases[0][0], 'height':cases[0][1]}, service_workers='block')
+            errors, forbidden = [], []
+            page.set_default_timeout(5000)
+            page.on('pageerror', lambda err: errors.append(str(err)))
+            await page.add_init_script('window.actions=[]')
+            async def route(r):
+                url = r.request.url
+                if not url.startswith(BASE) or any(f'/{part}/' in url for part in ('api','hubs')):
+                    forbidden.append(url)
+                    await r.abort()
+                elif url.endswith('/overlay-test.html'):
+                    await r.fulfill(content_type='text/html', body=HTML)
+                elif '/src/hooks/use-streaming-connection' in url and url.split('?')[0].endswith(('use-streaming-connection','use-streaming-connection.ts')):
+                    await r.fulfill(content_type='text/javascript', body=STUB)
+                else:
+                    await r.continue_()
+            await page.route('**/*', route)
+            await page.goto(BASE+'overlay-test.html')
+            await page.locator('video').wait_for()
+            if hit_only:
+                failures.extend(await hit_cases(page, cases))
+                assert await page.evaluate('actions') == [], 'layout interactions must not alter the session'
+                assert not errors and not forbidden, (errors, forbidden)
+                await page.close()
+                continue
+            for width,height,iw,ih in cases:
+                await page.set_viewport_size({'width':width,'height':height})
+                await page.evaluate(PLAY, [iw,ih])
+                layout = page.locator('[data-touch-layout]')
+                await expect(layout).to_have_attribute('data-touch-layout','portrait' if height>width else 'landscape')
+                # Exercise desktop mouse-triggered HUD too.
+                if not mobile:
+                    await page.mouse.move(5, 5)
+                await page.evaluate(SETTLE)
+                on = await page.evaluate(MEASURE)
+                name = f'{"mobile" if mobile else "desktop-touch"}-{width}x{height}-{iw}x{ih}'
+                if OUT:
+                    await page.screenshot(path=OUT/f'{name}-on.png', animations='disabled')
+                await page.get_by_role('button',name='隐藏触屏手柄',exact=True).tap()
+                await expect(layout).to_have_count(0)
+                await page.evaluate(SETTLE)
+                off = await page.evaluate(MEASURE)
+                if OUT:
+                    await page.screenshot(path=OUT/f'{name}-off.png', animations='disabled')
+                await page.get_by_role('button',name='显示触屏手柄',exact=True).tap()
+                await expect(layout).to_be_visible()
+                again = await page.evaluate(MEASURE)
+                issues = []
+                for s in (on,off,again):
+                    if not (s['same'] and s['playing'] and s['intrinsic']==[iw,ih] and s['fit']=='contain' and s['position']=='50% 50%'):
+                        issues.append('video identity/playback/contain changed')
+                    if any(s[k]!=on[k] for k in ('video','image')):
+                        issues.append('touch toggle changed video/image rect')
+                    if len(s['hud']) not in ((5,) if mobile else (4, 5)):
+                        issues.append(f'unexpected HUD count: {s["hud"]}')
+                    for i, a in enumerate(s['hud']):
+                        if not (a['hit'] and float(a['opacity']) > 0 and a['rect'][2]>=36 and a['rect'][3]>=44 and contains([0,0,width,height],a['rect'])):
+                            issues.append(f'HUD not clear/reachable: {a}')
+                        if any(overlaps(a['rect'], b['rect']) for b in s['hud'][i+1:]):
+                            issues.append(f'HUD overlap: {a["name"]}')
+                assert len(on['controls']) == len(again['controls']) == 19
+                for s in (on,again):
+                    for i,a in enumerate(s['controls']):
+                        r = a['rect']
+                        if not (a['hit'] and r[2]>=27 and r[3]>=27 and contains(s['image'],r)):
+                            issues.append(f'control out of image, too small or obstructed: {a}')
+                        if any(overlaps(r,b['rect']) for b in s['controls'][i+1:]+s['hud']):
+                            issues.append(f'control overlap: {a["name"]}')
+                summary=page.locator('details[aria-label="串流诊断"] > summary')
+                if any(h['hit'] for h in again['hud'] if '串流诊断' in h['name']):
+                    await summary.tap()
+                    await expect(layout).to_be_hidden()
+                    await summary.tap()
+                    await expect(layout).to_be_visible()
+                print(json.dumps({'case':name,'on':on,'off':off,'issues':list(dict.fromkeys(issues))},ensure_ascii=False),flush=True)
+                failures.extend((name,issue) for issue in list(dict.fromkeys(issues)))
+            assert await page.evaluate('actions') == [], 'layout interactions must not disconnect or end the session'
+            assert not errors and not forbidden, (errors, forbidden)
+            await page.close()
+        await browser.close()
+    if failures:
+        raise AssertionError(f'{len(failures)} layout failures; see per-viewport browser report')
+
+
+if __name__ == '__main__':
+    asyncio.run(main())
