@@ -0,0 +1,64 @@
+using SIPSorcery.Net;
+
+namespace RemotePlay.Services.WebRTC;
+
+/// <summary>
+/// Subscribe immediately after peer creation: SIPSorcery replays existing candidates
+/// only to the first subscriber. Buffer them until the session's queue is available.
+/// </summary>
+internal sealed class IceGatheringObserver
+{
+    private readonly RTCPeerConnection _peer;
+    private readonly object _gate = new();
+    private readonly Dictionary<string, RTCIceCandidate> _candidates = new();
+    private Action<RTCIceCandidate>? _sink;
+    private readonly TaskCompletionSource<bool> _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+    public IceGatheringObserver(RTCPeerConnection peer)
+    {
+        _peer = peer;
+        peer.onicecandidate += OnCandidate;
+        peer.onicegatheringstatechange += state =>
+        {
+            if (state == RTCIceGatheringState.complete) _completion.TrySetResult(true);
+        };
+        // Gathering can have completed before event subscription.
+        CheckComplete();
+    }
+
+    public Task Completion { get { CheckComplete(); return _completion.Task; } }
+    public bool IsComplete { get { CheckComplete(); return _completion.Task.IsCompleted; } }
+    public int CandidateCount { get { lock (_gate) return _candidates.Count; } }
+    public int HostCount => CountType("host");
+    public int SrflxCount => CountType("srflx");
+    public int RelayCount => CountType("relay");
+
+    public void SetCandidateSink(Action<RTCIceCandidate> sink)
+    {
+        lock (_gate)
+        {
+            _sink = sink;
+            foreach (var candidate in _candidates.Values) sink(candidate);
+        }
+    }
+
+    private void OnCandidate(RTCIceCandidate candidate)
+    {
+        // This library need not emit a null end-of-candidates sentinel.
+        if (candidate?.candidate == null) return;
+        lock (_gate)
+        {
+            if (_candidates.TryAdd(candidate.candidate, candidate)) _sink?.Invoke(candidate);
+        }
+    }
+
+    private void CheckComplete()
+    {
+        if (_peer.iceGatheringState == RTCIceGatheringState.complete) _completion.TrySetResult(true);
+    }
+
+    private int CountType(string type)
+    {
+        lock (_gate) return _candidates.Values.Count(c => c.candidate.Contains("typ " + type, StringComparison.OrdinalIgnoreCase));
+    }
+}
