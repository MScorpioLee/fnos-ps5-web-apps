+"""Real Chromium negotiation with Safari's constrained-baseline H264 preference.
+Requires Playwright and an installed Chromium; never downloads a browser.
+"""
+import asyncio
+import json
+import os
+from pathlib import Path
+import sys
+import subprocess
+from playwright.async_api import async_playwright
+
+JS = r"""async offer => {
+  const pc = new RTCPeerConnection({iceServers: []});
+  try {
+    const codecs = RTCRtpReceiver.getCapabilities('video').codecs.filter(c =>
+      c.mimeType.toLowerCase() === 'video/h264' &&
+      /(?:^|;)profile-level-id=42e01f(?:;|$)/i.test(c.sdpFmtpLine || '') &&
+      /(?:^|;)packetization-mode=1(?:;|$)/.test(c.sdpFmtpLine || ''));
+    if (!codecs.length) throw new Error('Chromium missing required 42e01f capability');
+    const transceiver = pc.addTransceiver('video', {direction: 'recvonly'});
+    try {
+      await pc.setRemoteDescription({type: 'offer', sdp: offer});
+      transceiver.setCodecPreferences(codecs);
+      const answer = await pc.createAnswer();
+      await pc.setLocalDescription(answer);
+      const video = answer.sdp.split(/(?=m=)/).find(s => s.startsWith('m=video '));
+      const lines = video.split(/\r?\n/);
+      return {accepted: !/^m=video 0 /.test(video) && lines.includes('a=rtpmap:96 H264/90000'),
+        video: lines.filter(s => /^(m=|a=rtpmap:|a=fmtp:)/.test(s)), preferences: codecs};
+    } catch (e) { return {accepted: false, error: e.name + ': ' + e.message, preferences: codecs}; }
+  } finally { pc.close(); }
+}"""
+
+async def main():
+    offers = json.load(sys.stdin)
+    async with async_playwright() as pw:
+        executable = os.environ.get('PSRP_CHROMIUM_PATH')
+        if not executable:
+            installed = sorted((Path.home() / '.cache/ms-playwright').glob('chromium-*/chrome-linux64/chrome'))
+            if installed:
+                executable = str(installed[-1])
+        browser = await pw.chromium.launch(headless=True, **({'executable_path': executable} if executable else {}))
+        try:
+            page = await browser.new_page()
+            results = {name: await page.evaluate(JS, sdp) for name, sdp in offers.items()}
+            print(json.dumps({'engine': 'chromium', 'version': browser.version, 'cases': results}))
+            # Chromium is intentionally not the Safari rejection oracle: it accepts
+            # baseline 42001f even with constrained-baseline codec preferences.
+            # The real RFC 6184 library below provides strict profile matching.
+            for name in ('track', 'wire', 'fallback'):
+                assert results[name]['accepted'], f'{name}: Safari-filtered 42e01f preferences rejected H26496'
+        finally:
+            await browser.close()
+    match = subprocess.run(['node', str(Path(__file__).with_name('safari_h264_match.cjs'))],
+                           input=json.dumps(offers), text=True, capture_output=True)
+    print(match.stdout, end='')
+    if match.returncode:
+        raise AssertionError(match.stderr)
+
+asyncio.run(main())
