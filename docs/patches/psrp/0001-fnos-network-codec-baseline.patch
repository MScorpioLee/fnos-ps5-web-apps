+using System.Buffers.Binary;
+using System.Net;
+using System.Net.Sockets;
+using System.Security.Cryptography;
+using Makaretu.Dns;
+using SIPSorcery.Net;
+
+namespace RemotePlay.Services.WebRTC;
+
+// Only the built-in STUN allowlist uses this resolver. User TURN is never rewritten.
+internal sealed class StunNetwork
+{
+    private static readonly (string Host, int Port)[] Servers =
+        [("stun.l.google.com", 19302), ("stun.cloudflare.com", 3478)];
+    public IPAddress? BindAddress { get; }
+    public IPAddress? DnsServer => _dnsEndpoint?.Address;
+    private readonly IPEndPoint? _dnsEndpoint;
+    private readonly TimeProvider _clock;
+    private readonly SemaphoreSlim _gate = new(1, 1);
+
+    public StunNetwork(IPAddress? bind, IPEndPoint? dns, TimeProvider clock)
+    { BindAddress = bind; _dnsEndpoint = dns; _clock = clock; }
+
+    public static StunNetwork FromEnvironment() => FromValues(
+        Environment.GetEnvironmentVariable("PSRP_WEBRTC_BIND_ADDRESS"),
+        Environment.GetEnvironmentVariable("PSRP_WEBRTC_DNS_SERVER"));
+
+    public static StunNetwork FromValues(string? bind, string? dns)
+    {
+        if (string.IsNullOrEmpty(bind) && string.IsNullOrEmpty(dns)) return new(null, null, TimeProvider.System);
+        static bool Valid(string? value, out IPAddress? ip) => IPAddress.TryParse(value, out ip)
+            && ip.AddressFamily == AddressFamily.InterNetwork && !ip.Equals(IPAddress.Any)
+            && !ip.Equals(IPAddress.Broadcast) && ip.GetAddressBytes()[0] < 224;
+        if (!Valid(bind, out var b) || !Valid(dns, out var d))
+            throw new ArgumentException("PSRP_WEBRTC_BIND_ADDRESS and PSRP_WEBRTC_DNS_SERVER must both be concrete IPv4 addresses.");
+        return new(b, new IPEndPoint(d!, 53), TimeProvider.System);
+    }
+
+    public async Task ApplyAsync(RTCConfiguration config)
+    {
+        if (BindAddress == null)
+        {
+            config.iceServers = new() { new() { urls = "stun:stun.l.google.com:19302" } };
+            return;
+        }
+        await _gate.WaitAsync();
+        try
+        {
+            var servers = new List<RTCIceServer>();
+            foreach (var (host, port) in Servers)
+            {
+                try
+                {
+                    var result = await ResolveAsync(host);
+                    foreach (var address in result.Addresses)
+                        servers.Add(new RTCIceServer { urls = $"stun:{address}:{port}" });
+                }
+                catch (Exception ex) when (ex is SocketException or OperationCanceledException or InvalidDataException or FormatException or ArgumentException or EndOfStreamException)
+                {
+                    // Deliberately do not attach exceptions containing endpoints or packet data.
+                }
+            }
+            if (servers.Count == 0)
+                throw new InvalidOperationException("Independent STUN DNS resolution failed: no validated global IPv4 answers; system DNS fallback is disabled.");
+            config.iceServers = servers;
+            config.X_BindAddress = BindAddress;
+        }
+        finally { _gate.Release(); }
+    }
+
+    // At most two entries (the fixed allowlist), no negative or stale fallback cache.
+    private readonly Dictionary<string, (Answer Value, long Started)> _cache = new();
+    private async Task<Answer> ResolveAsync(string host)
+    {
+        if (_cache.TryGetValue(host, out var entry)
+            && _clock.GetElapsedTime(entry.Started) < entry.Value.Ttl) return entry.Value;
+        _cache.Remove(host);
+        var started = _clock.GetTimestamp();
+        var result = await QueryAsync(host);
+        if (result.Ttl > TimeSpan.Zero && _clock.GetElapsedTime(started) < result.Ttl)
+            _cache[host] = (result, started);
+        return result;
+    }
+    private sealed record Answer(IPAddress[] Addresses, TimeSpan Ttl);
+    private async Task<Answer> QueryAsync(string host)
+    {
+        using var timeout = new CancellationTokenSource(TimeSpan.FromMilliseconds(1500));
+        using var udp = new UdpClient(new IPEndPoint(BindAddress!, 0));
+        // Connected UDP filters source IP AND port in the kernel; explicit equality is defense in depth.
+        udp.Connect(_dnsEndpoint!);
+        var query = new Message { Id = (ushort)RandomNumberGenerator.GetInt32(65536), RD = true };
+        query.Questions.Add(new Question { Name = host, Type = DnsType.A, Class = DnsClass.IN });
+        await udp.SendAsync(query.ToByteArray(), timeout.Token);
+        var received = await udp.ReceiveAsync(timeout.Token);
+        if (!received.RemoteEndPoint.Equals(_dnsEndpoint)) throw new InvalidDataException();
+        var bytes = SafeAnswerEnvelope(received.Buffer);
+        var reply = new Message();
+        reply.Read(bytes); // Reuse the already-shipped Makaretu.Dns wire codec, not a custom DNS decoder.
+        if (reply.Id != query.Id || !reply.IsResponse || reply.Opcode != query.Opcode || reply.TC
+            || reply.Z != 0 || reply.Status != 0 || reply.Questions.Count != 1)
+            throw new InvalidDataException();
+        var question = reply.Questions[0];
+        if (question.Name != query.Questions[0].Name || question.Type != DnsType.A || question.Class != DnsClass.IN)
+            throw new InvalidDataException();
+        var name = question.Name;
+        var ttl = TimeSpan.FromSeconds(30);
+        // Only accept A records for the requested owner, or a bounded in-answer CNAME chain.
+        for (int depth = 0; depth < 8; depth++)
+        {
+            var records = reply.Answers.Where(r => r.Name == name && r.Class == DnsClass.IN).ToArray();
+            var aliases = records.OfType<CNAMERecord>().ToArray();
+            var addresses = records.OfType<ARecord>().ToArray();
+            if (aliases.Length == 0)
