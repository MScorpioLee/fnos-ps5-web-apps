+using System.Net;
+using System.Net.Sockets;
+using RemotePlay.Services.WebRTC;
+using Makaretu.Dns;
+
+sealed class TestClock : TimeProvider
+{
+    long ticks;
+    public override long TimestampFrequency => TimeSpan.TicksPerSecond;
+    public override long GetTimestamp() => ticks;
+    public void Advance(int seconds) => ticks += TimeSpan.FromSeconds(seconds).Ticks;
+}
+sealed class DnsFixture : IDisposable
+{
+    readonly UdpClient socket = new(new IPEndPoint(IPAddress.Loopback, 0));
+    readonly CancellationTokenSource stop = new();
+    readonly Task worker;
+    readonly int ttl;
+    public string Mode;
+    public int Queries;
+    public bool SourceCorrect = true;
+    public TestClock Clock = new();
+    public object Network { get; }
+    public DnsFixture(string mode, int ttl = 10)
+    {
+        Mode = mode; this.ttl = ttl;
+        var type = typeof(WebRTCSignalingService).Assembly.GetType("RemotePlay.Services.WebRTC.StunNetwork")!;
+        // Transport seam only: production always uses configured DNS port 53.
+        var ctor = type.GetConstructor(new[] { typeof(IPAddress), typeof(IPEndPoint), typeof(TimeProvider) });
+        if (ctor == null) throw new Exception("source-bound DNS transport missing");
+        Network = ctor.Invoke(new object[] { IPAddress.Loopback, socket.Client.LocalEndPoint!, Clock });
+        worker = Run();
+    }
+    async Task Run()
+    {
+        try
+        {
+            while (!stop.IsCancellationRequested)
+            {
+                var received = await socket.ReceiveAsync(stop.Token);
+                Interlocked.Increment(ref Queries);
+                SourceCorrect &= received.RemoteEndPoint.Address.Equals(IPAddress.Loopback);
+                if (Mode == "silent") continue;
+                var q = new Message(); q.Read(received.Buffer);
+                var response = q.CreateResponse();
+                var ip = Mode switch {
+                    "fake" => "198.18.0.8", "private" => "10.0.0.1", "loopback" => "127.0.0.2", "linklocal" => "169.254.1.1", "multicast" => "224.0.0.1", "documentation" => "203.0.113.1", "shared" => "100.64.0.1", "reserved" => "240.0.0.1", _ => "8.8.8.8"
+                };
+                response.Answers.Add(new ARecord { Name = q.Questions[0].Name, Address = IPAddress.Parse(ip), TTL = TimeSpan.FromSeconds(ttl) });
+                if (Mode == "cname")
+                {
+                    response.Answers[0].Name = "alias.example";
+                    response.Answers.Insert(0, new CNAMERecord { Name = q.Questions[0].Name, Target = "alias.example", TTL = TimeSpan.FromSeconds(1) });
+                }
+                switch (Mode)
+                {
+                    case "id": response.Id ^= 1; break;
+                    case "question": response.Questions[0].Name = "unrelated.example"; break;
+                    case "qr": response.QR = false; break;
+                    case "opcode": response.Opcode = (MessageOperation)1; break;
+                    case "truncated": response.TC = true; break;
+                    case "rcode": response.Status = (MessageStatus)3; break;
+                    case "class": response.Questions[0].Class = (DnsClass)3; break;
+                    case "owner": response.Answers[0].Name = "unrelated.example"; break;
+                }
+                var bytes = response.ToByteArray();
+                if (Mode == "malformed") bytes = bytes[..13];
+                if (Mode == "compression") { bytes[12] = 0xc0; bytes[13] = 12; }
+                if (Mode == "source") { using var other = new UdpClient(new IPEndPoint(IPAddress.Loopback, 0)); await other.SendAsync(bytes, received.RemoteEndPoint); }
+                else await socket.SendAsync(bytes, received.RemoteEndPoint);
+            }
+        }
+        catch (OperationCanceledException) { }
+        catch (ObjectDisposedException) { }
+    }
+    public void Dispose() { stop.Cancel(); socket.Dispose(); worker.GetAwaiter().GetResult(); stop.Dispose(); }
+}
