+        }
+        throw new InvalidDataException();
+    }
+
+    private static bool IsGlobalIPv4(IPAddress ip)
+    {
+        if (ip.AddressFamily != AddressFamily.InterNetwork) return false;
+        var b = ip.GetAddressBytes();
+        // Conservative IANA special-use exclusions, including benchmark/fakeIP 198.18/15.
+        return !(b[0] is 0 or 10 or 127 || b[0] >= 224
+            || b[0] == 100 && b[1] is >= 64 and <= 127
+            || b[0] == 169 && b[1] == 254 || b[0] == 172 && b[1] is >= 16 and <= 31
+            || b[0] == 192 && (b[1] == 168 || b[1] == 0 && b[2] is 0 or 2 || b[1] == 88 && b[2] == 99)
+            || b[0] == 198 && (b[1] is 18 or 19 || b[1] == 51 && b[2] == 100)
+            || b[0] == 203 && b[1] == 0 && b[2] == 113);
+    }
+
+    // Bound packet size/counts and compressed names before invoking the library. Only
+    // A/CNAME answer payloads are decoded; unused authority/additional RDATA is skipped.
+    private static byte[] SafeAnswerEnvelope(byte[] data)
+    {
+        if (data.Length is < 12 or > 4096) throw new InvalidDataException();
+        int U16(int p) { if (p + 2 > data.Length) throw new InvalidDataException(); return BinaryPrimitives.ReadUInt16BigEndian(data.AsSpan(p, 2)); }
+        int Name(int p)
+        {
+            int end = -1, length = 0;
+            for (int steps = 0; steps < 128; steps++)
+            {
+                if (p >= data.Length) throw new InvalidDataException();
+                int start = p, n = data[p++];
+                if (n == 0) return end < 0 ? p : end;
+                if ((n & 0xc0) == 0xc0)
+                {
+                    if (p >= data.Length) throw new InvalidDataException();
+                    int target = ((n & 63) << 8) | data[p++];
+                    if (target < 12 || target >= start) throw new InvalidDataException();
+                    if (end < 0) end = p;
+                    p = target;
+                }
+                else
+                {
+                    if (n > 63 || p + n > data.Length || (length += n + 1) > 254) throw new InvalidDataException();
+                    p += n;
+                }
+            }
+            throw new InvalidDataException();
+        }
+        if (U16(4) != 1) throw new InvalidDataException();
+        int answers = U16(6), others = U16(8) + U16(10);
+        if (answers > 16 || others > 32) throw new InvalidDataException();
+        int offset = Name(12) + 4, answerEnd = offset;
+        if (offset > data.Length) throw new InvalidDataException();
+        for (int i = 0; i < answers + others; i++)
+        {
+            offset = Name(offset);
+            if (offset + 10 > data.Length) throw new InvalidDataException();
+            int type = U16(offset), count = U16(offset + 8);
+            offset += 10;
+            if (offset + count > data.Length) throw new InvalidDataException();
+            if (i < answers)
+            {
+                if (type == 1 && count != 4 || type == 5 && Name(offset) != offset + count || type is not (1 or 5))
+                    throw new InvalidDataException();
+            }
+            offset += count;
+            if (i < answers) answerEnd = offset;
+        }
+        if (offset != data.Length) throw new InvalidDataException();
+        var result = data[..answerEnd];
+        result.AsSpan(8, 4).Clear();
+        return result;
+    }
