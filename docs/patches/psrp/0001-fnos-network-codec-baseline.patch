+static WebRTCSignalingService Service(ILogger<WebRTCSignalingService>? logger = null) => new(logger ?? NullLogger<WebRTCSignalingService>.Instance, NullLoggerFactory.Instance, serviceProvider: new ServiceCollection().BuildServiceProvider());
+static string Answer(string offer, int mode) {
+    var s = Regex.Replace(offer, @"(?m)^a=fmtp:96 [^\r\n]*\r?\n", "");
