+using System.Text.Json;
+
+namespace RemotePlay.Services.WebRTC;
+
+/// <summary>Allowlisted diagnostics only. Never serialize SDP or arbitrary attribute values.</summary>
+internal static class AnswerVideoSummary
+{
+    private sealed class Video
+    {
+        public bool Rejected;
+        public Dictionary<int, Format> Formats = new();
+    }
+
+    private sealed class Format
+    {
+        public string Codec = "other";
+        public string PacketizationMode = "unspecified";
+    }
+
+    public static string Create(string sdp)
+    {
+        var videos = new List<Video>();
+        Video? video = null;
+        foreach (var raw in sdp.Split('\n'))
+        {
+            var line = raw.Trim();
+            if (line.StartsWith("m=", StringComparison.Ordinal))
+            {
+                video = null;
+                var parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+                if (parts.Length < 4 || parts[0] != "m=video") continue;
+                video = new Video { Rejected = parts[1].Split('/')[0] == "0" };
+                foreach (var pt in parts.Skip(3))
+                    if (int.TryParse(pt, out int id) && id is >= 0 and <= 127)
+                        video.Formats.TryAdd(id, new Format());
+                videos.Add(video);
+                continue;
+            }
+            if (video == null) continue;
+            bool rtpmap = line.StartsWith("a=rtpmap:", StringComparison.Ordinal);
+            bool fmtp = line.StartsWith("a=fmtp:", StringComparison.Ordinal);
+            if (!rtpmap && !fmtp) continue;
+            var attribute = line[(line.IndexOf(':') + 1)..].Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
+            if (attribute.Length != 2 || !int.TryParse(attribute[0], out int payload) || !video.Formats.TryGetValue(payload, out var format)) continue;
+            if (rtpmap)
+            {
+                var codec = attribute[1].Split('/')[0].ToUpperInvariant();
+                format.Codec = codec is "H264" or "H265" or "VP8" or "VP9" or "AV1" or "RTX" or "RED" or "ULPFEC" or "FLEXFEC-03" ? codec : "other";
+            }
+            else
+            {
+                foreach (var parameter in attribute[1].Split(';'))
+                {
+                    var pair = parameter.Split('=', 2, StringSplitOptions.TrimEntries);
+                    if (pair.Length == 2 && pair[0].Equals("packetization-mode", StringComparison.OrdinalIgnoreCase))
+                        format.PacketizationMode = pair[1] is "0" or "1" or "2" ? pair[1] : "invalid";
+                }
+            }
+        }
+        return JsonSerializer.Serialize(videos.Select(v => new
+        {
+            rejected = v.Rejected,
+            formats = v.Formats.Select(f => new { codec = f.Value.Codec, pt = f.Key, packetizationMode = f.Value.PacketizationMode })
+        }));
+    }
+}
