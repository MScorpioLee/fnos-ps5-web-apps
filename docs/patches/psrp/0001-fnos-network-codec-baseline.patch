+static async Task EarlyIce() {
+    using var peer = new RTCPeerConnection(new RTCConfiguration { iceServers = new() });
+    // The observer used by CreateSession must subscribe first, before receiver/channel work.
+    var type = typeof(WebRTCSignalingService).Assembly.GetType("RemotePlay.Services.WebRTC.IceGatheringObserver");
+    if (type == null) {
+        // Reproduce the pre-fix service order against the real library.
+        using var oldReceiver = new WebRTCReceiver("test", peer, NullLogger<WebRTCReceiver>.Instance);
+        await Task.Delay(100);
+        var oldOffer = peer.createOffer(); await peer.setLocalDescription(oldOffer);
+        int observed = 0;
+        peer.onicecandidate += c => { if (c != null) Interlocked.Increment(ref observed); };
+        await Task.Delay(100);
+        Check(observed == ((RtpIceChannel)peer.GetRtpChannel()).Candidates.Count,
+            $"early ICE candidates lost: observed={observed}, actual={((RtpIceChannel)peer.GetRtpChannel()).Candidates.Count}");
+        return;
+    }
+    var observer = Activator.CreateInstance(type!, new object[] { peer })!;
+    await Task.Delay(100); // exercise candidate arrival before a session can be constructed
+    using var receiver = new WebRTCReceiver("test", peer, NullLogger<WebRTCReceiver>.Instance);
+    var candidates = new List<RTCIceCandidate>();
+    type!.GetMethod("SetCandidateSink")!.Invoke(observer, new object[] { (Action<RTCIceCandidate>)(c => candidates.Add(c)) });
+    var offer = peer.createOffer(); await peer.setLocalDescription(offer);
+    var completion = (Task)type.GetProperty("Completion")!.GetValue(observer)!;
+    Check(await Task.WhenAny(completion, Task.Delay(3000)) == completion, "gathering complete state did not finish wait (no null candidate event required)");
+    var actual = ((RtpIceChannel)peer.GetRtpChannel()).Candidates.Count;
+    Check(actual > 0, "isolated peer did not gather a host candidate");
+    Check((int)type.GetProperty("CandidateCount")!.GetValue(observer)! == actual, "early candidates undercounted");
+    Check(candidates.Count == actual, "pre-session candidates not replayed to pending queue");
+    // Already-complete construction must also complete without waiting for a future event.
+    var late = Activator.CreateInstance(type, new object[] { peer })!;
+    Check(((Task)type.GetProperty("Completion")!.GetValue(late)!).IsCompleted, "already complete gathering state missed");
+}
