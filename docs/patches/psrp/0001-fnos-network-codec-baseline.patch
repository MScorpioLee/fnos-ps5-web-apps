+// Real RFC 6184 profile negotiation library used by mediasoup-client.
+// Dependency: h264-profile-level-id@2.3.3 (set NODE_PATH if external).
+const h264 = require('h264-profile-level-id');
+let input = '';
+process.stdin.on('data', data => input += data);
+process.stdin.on('end', () => {
+  const offers = JSON.parse(input);
+  const safari = {'profile-level-id': '42e01f', 'packetization-mode': 1, 'level-asymmetry-allowed': 1};
+  const results = {};
+  for (const [name, sdp] of Object.entries(offers)) {
+    const fmtp = /^a=fmtp:96 ([^\r\n]*)/m.exec(sdp)?.[1] || '';
+    const params = Object.fromEntries(fmtp.split(';').filter(Boolean).map(p => p.trim().split('=')));
+    let profileAnswer, error;
+    try { profileAnswer = h264.generateProfileLevelIdStringForAnswer(safari, params); }
+    catch (e) { error = e.message; }
+    results[name] = {accepted: !error && h264.isSameProfile(safari, params) && Number(params['packetization-mode'] || 0) === 1,
+      profileAnswer, error, payloadType: 96, profile: h264.parseSdpProfileLevelId(params)};
+  }
+  console.log(JSON.stringify({library: 'h264-profile-level-id@2.3.3', cases: results}));
+  if (results.old42001f.accepted) throw new Error('negative control: baseline 42001f unexpectedly accepted');
+  for (const name of ['track', 'wire', 'fallback']) {
+    if (!results[name].accepted) throw new Error(`${name}: Safari 42e01f rejected H26496`);
+  }
+});
