+import { useEffect, useRef, useState, type RefObject } from 'react'
+import { Maximize, Minimize } from 'lucide-react'
+
+type FullscreenContainer = HTMLDivElement & { webkitRequestFullscreen?: () => Promise<void> | void }
+type FullscreenDocument = Document & {
+  webkitFullscreenElement?: Element | null
+  webkitFullscreenEnabled?: boolean
+  webkitExitFullscreen?: () => Promise<void> | void
+}
+
+/** Fullscreen belongs to the entire streaming UI, never the video alone. */
+export function StreamingFullscreenButton({ containerRef }: { containerRef: RefObject<HTMLDivElement> }) {
+  const [active, setActive] = useState(false)
+  const [busy, setBusy] = useState(false)
+  const [message, setMessage] = useState('')
+  const pending = useRef(false)
+  const doc = document as FullscreenDocument
+
+  useEffect(() => {
+    const sync = () => setActive((doc.fullscreenElement || doc.webkitFullscreenElement) === containerRef.current)
+    sync()
+    document.addEventListener('fullscreenchange', sync)
+    document.addEventListener('webkitfullscreenchange', sync)
+    return () => {
+      document.removeEventListener('fullscreenchange', sync)
+      document.removeEventListener('webkitfullscreenchange', sync)
+    }
+  }, [containerRef, doc])
+
+  const toggle = async () => {
+    if (pending.current) return
+    const container = containerRef.current as FullscreenContainer | null
+    if (!container) return
+    setMessage('')
+    pending.current = true
+    setBusy(true)
+    try {
+      const current = doc.fullscreenElement || doc.webkitFullscreenElement
+      if (current === container) {
+        const exit = doc.exitFullscreen || doc.webkitExitFullscreen
+        if (!exit) throw new Error('Fullscreen exit is unavailable')
+        await exit.call(doc)
+      } else {
+        const request = container.requestFullscreen || container.webkitRequestFullscreen
+        const enabled = typeof container.requestFullscreen === 'function' ? doc.fullscreenEnabled : doc.webkitFullscreenEnabled
+        if (!request || enabled === false) {
+          setMessage('此浏览器或页面不支持容器全屏；当前保持页面内显示，保留手柄与退出控制。')
+          return
+        }
+        // Invoked synchronously from the button gesture, before any await.
+        await request.call(container)
+      }
+    } catch {
+      setMessage('无法切换全屏：浏览器可能拒绝了请求。请重试或检查页面权限；串流不受影响。')
+    } finally {
+      pending.current = false
+      setBusy(false)
+      setActive((doc.fullscreenElement || doc.webkitFullscreenElement) === container)
+    }
+  }
+
+  return <>
+    <button
+      type="button"
+      aria-label={active ? '退出全屏' : '全屏'}
+      aria-pressed={active}
+      disabled={busy}
+      title={active ? '退出全屏（也可按 Esc）' : '全屏显示视频与控制界面'}
+      className="fixed z-[10001] flex min-h-[44px] items-center gap-2 rounded-lg border border-white/60 bg-black/80 px-4 py-2 text-sm font-medium text-white shadow-lg hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
+      style={{ top: 'max(8px, env(safe-area-inset-top))', left: '50%', transform: 'translateX(-50%)', touchAction: 'manipulation' }}
+      onPointerDown={event => event.stopPropagation()}
+      onPointerUp={event => event.stopPropagation()}
+      onTouchStart={event => event.stopPropagation()}
+      onTouchEnd={event => event.stopPropagation()}
+      onClick={event => { event.stopPropagation(); void toggle() }}
+    >
+      {active ? <Minimize aria-hidden="true" size={18} /> : <Maximize aria-hidden="true" size={18} />}
+      {active ? '退出全屏' : '全屏'}
+    </button>
+    {message && <div role="status" className="fixed z-[10001] rounded bg-black/90 p-3 text-sm text-white pointer-events-none" style={{ top: 'calc(max(8px, env(safe-area-inset-top)) + 52px)', left: '50%', transform: 'translateX(-50%)', width: 'max-content', maxWidth: '90vw' }}>{message}</div>}
+  </>
+}
