+export type PresentedVideo = {
+  requestVideoFrameCallback?: (callback: (now: number, metadata: { presentedFrames: number }) => void) => number;
+  cancelVideoFrameCallback?: (handle: number) => void;
+};
+/** Observe the already-playing element, never create another decoder/video/track consumer. */
+export function observePresentedFrames(video: PresentedVideo) {
+  const supported = typeof video.requestVideoFrameCallback === 'function' && typeof video.cancelVideoFrameCallback === 'function';
+  let stopped = false, handle: number | undefined;
+  let baseline: { time: number; frames: number } | null = null;
+  let latest: { time: number; frames: number } | null = null;
+  const callback = (now: number, metadata: { presentedFrames: number }) => {
+    if (stopped) return;
+    if (Number.isFinite(now) && Number.isFinite(metadata.presentedFrames)) {
+      if (latest && (now <= latest.time || metadata.presentedFrames < latest.frames)) baseline = null;
+      latest = { time: now, frames: metadata.presentedFrames };
+      baseline ??= latest;
+    }
+    handle = video.requestVideoFrameCallback!(callback);
+  };
+  if (supported) handle = video.requestVideoFrameCallback!(callback);
+  return {
+    sample(now = performance.now()) {
+      const presentFps = !stopped && baseline && latest && latest.time > baseline.time && now > baseline.time
+        ? (latest.frames - baseline.frames) * 1000 / (now - baseline.time) : null;
+      // Include wall-time since last poll, including stalls after the latest frame.
+      baseline = latest ? { time: Math.max(now, latest.time), frames: latest.frames } : null;
+      return { presentFps, presentationSupport: supported ? 'requestVideoFrameCallback' as const : 'decode-only' as const };
+    },
+    stop() { stopped = true; if (handle !== undefined) video.cancelVideoFrameCallback?.(handle); },
+  };
+}
