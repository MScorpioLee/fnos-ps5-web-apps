+import { useEffect, useState } from 'react'
+import { MobileVirtualController } from './MobileVirtualController'
+import { MobileVirtualControllerPortrait } from './MobileVirtualControllerPortrait'
+
+// Capability, never UA: car browsers and touch PCs commonly report desktop UAs.
+export function hasTouchControls() {
+  return navigator.maxTouchPoints > 0 || window.matchMedia?.('(any-pointer: coarse)').matches === true
+}
+export function StreamingTouchControls({ sessionId, onVisibilityChange }: { sessionId: string | null; onVisibilityChange?: (visible: boolean) => void }) {
+  const [preference, setPreference] = useState<boolean | null>(null)
+  const [touch, setTouch] = useState(hasTouchControls)
+  const [portrait, setPortrait] = useState(() => window.innerHeight > window.innerWidth)
+  useEffect(() => {
+    const media = window.matchMedia('(any-pointer: coarse)')
+    const update = () => { setTouch(hasTouchControls()); setPortrait(window.innerHeight > window.innerWidth) }
+    window.addEventListener('resize', update)
+    media.addEventListener?.('change', update)
+    return () => { window.removeEventListener('resize', update); media.removeEventListener?.('change', update) }
+  }, [])
+  const visible = preference ?? touch
+  useEffect(() => { onVisibilityChange?.(visible) }, [visible, onVisibilityChange])
+  const Layout = portrait ? MobileVirtualControllerPortrait : MobileVirtualController
+  return <>
+    <button type="button" aria-label={visible ? '隐藏触屏手柄' : '显示触屏手柄'} aria-pressed={visible}
+      className="fixed z-[170] rounded border border-white/60 bg-black/85 px-3 text-sm text-white"
+      style={{ left: 'max(8px, env(safe-area-inset-left))', bottom: 'max(8px, env(safe-area-inset-bottom))', minHeight: 44 }}
+      onClick={() => setPreference(!visible)}>{visible ? '隐藏触屏手柄' : '显示触屏手柄'}</button>
+    {visible && <Layout sessionId={sessionId} isVisible />}
+  </>
+}
