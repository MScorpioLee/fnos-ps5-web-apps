+/** Passive video-only telemetry. Never changes resolution, codec, bitrate or sessions. */
+export type BufferMode = 'auto' | 'low-latency';
+export type BufferProperty = 'jitterBufferTarget' | 'playoutDelayHint';
+export type VideoReceiver = { readonly track: { readonly kind: string } | null; jitterBufferTarget?: number | null; playoutDelayHint?: number | null };
+export type BufferResult = { receiver: VideoReceiver; property: BufferProperty; unit: 'ms' | 's'; status: 'applied' | 'restored' | 'unsupported' | 'rejected'; readback?: number | null; error?: string };
+const bufferProperties: BufferProperty[] = ['jitterBufferTarget', 'playoutDelayHint'];
+/** Default auto is a no-op. Use one controller per connection. Writes are synchronous hints, not promises of latency. */
+export class VideoBufferController {
+  private originals = new Map<VideoReceiver, Map<BufferProperty, number | null | undefined>>();
+  apply(mode: BufferMode, receivers: readonly VideoReceiver[]): BufferResult[] {
+    const results: BufferResult[] = [];
+    const targets = mode === 'auto' ? [...this.originals.keys()] : receivers;
+    for (const receiver of targets) {
+      if (receiver.track?.kind !== 'video') continue;
+      for (const property of bufferProperties) {
+        const saved = this.originals.get(receiver);
+        if (mode === 'auto' && !saved?.has(property)) continue;
+        const result: BufferResult = { receiver, property, unit: property === 'jitterBufferTarget' ? 'ms' : 's', status: 'unsupported' };
+        results.push(result);
+        try {
+          if (!(property in receiver)) continue;
+          if (mode === 'low-latency' && !saved?.has(property)) {
+            const originals = saved ?? new Map<BufferProperty, number | null | undefined>();
+            originals.set(property, receiver[property]);
+            this.originals.set(receiver, originals);
+          }
+          const target = mode === 'auto' ? saved?.get(property) : 0;
+          receiver[property] = target;
+          const readback = receiver[property];
+          result.readback = readback;
+          if (!Object.is(target, readback)) throw new Error('Hint readback differs from requested value');
+          result.status = mode === 'auto' ? 'restored' : 'applied';
+          if (mode === 'auto') {
+            saved?.delete(property);
+            if (!saved?.size) this.originals.delete(receiver);
+          }
+        } catch (error) {
+          result.status = 'rejected'; result.error = String(error);
+        }
+      }
+    }
+    return results;
+  }
+}
