+"""Isolated real Chromium receiver property readback, no PS5/network/session.
+Run: python tests/browser_streaming_diagnostics_test.py [evidence.json]
+Override CHROMIUM_PATH for another installed Chromium. Not a car browser test.
+"""
+import asyncio
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+from playwright.async_api import async_playwright
+
+WEB = Path(__file__).resolve().parents[1]
+CHROME = os.environ.get('CHROMIUM_PATH', __import__('os').environ.get('CHROMIUM_PATH'))
+
+async def main():
+    with tempfile.TemporaryDirectory(prefix='psrp-diagnostics-browser-') as directory:
+        subprocess.run(['node', 'node_modules/typescript/bin/tsc', 'src/utils/streaming-diagnostics.ts', '--target', 'es2020', '--module', 'commonjs', '--strict', '--skipLibCheck', '--outDir', directory], cwd=WEB, check=True)
+        code = (Path(directory) / 'streaming-diagnostics.js').read_text()
+        async with async_playwright() as p:
+            browser = await p.chromium.launch(executable_path=CHROME, headless=True, args=['--no-sandbox'])
+            page = await browser.new_page()
+            # No navigation, HTTP server, backend, media source, negotiation or PS5.
+            await page.add_script_tag(content='window.exports = {};\n' + code)
+            result = await page.evaluate('''() => {
+                const pc = new RTCPeerConnection({iceServers: []});
+                try {
+                    const video = pc.addTransceiver('video', {direction:'recvonly'}).receiver;
+                    const audio = pc.addTransceiver('audio', {direction:'recvonly'}).receiver;
+                    const properties = ['jitterBufferTarget','playoutDelayHint'];
+                    const inspect = receiver => Object.fromEntries(properties.map(key => [key, {exists:key in receiver, value:receiver[key] === undefined ? 'undefined' : receiver[key]}]));
+                    const before = inspect(video), audioBefore = inspect(audio);
+                    const c = new window.exports.VideoBufferController();
+                    const initialAuto = c.apply('auto', [video,audio]);
+                    const compact = results => results.map(({receiver,...result})=>result);
+                    const low = compact(c.apply('low-latency',[video,audio]));
+                    const afterLow = inspect(video);
+                    const restored = compact(c.apply('auto',[video,audio]));
+                    return {ua:navigator.userAgent,rvfc:typeof HTMLVideoElement.prototype.requestVideoFrameCallback,
+                        initialAuto:compact(initialAuto),before,low,afterLow,restored,afterAuto:inspect(video),audioBefore,audioAfter:inspect(audio),
+                        scope:'Unnegotiated local recvonly receiver; property acceptance only, NOT streaming latency or vehicle compatibility'};
+                } finally { pc.close(); }
+            }''')
+            assert result['initialAuto'] == []
+            assert result['audioBefore'] == result['audioAfter']
+            assert result['before'] == result['afterAuto']
+            for row in result['low']:
+                expected = 'applied' if result['before'][row['property']]['exists'] else 'unsupported'
+                assert row['status'] == expected, row
+                if expected == 'applied':
+                    assert result['afterLow'][row['property']]['value'] == 0
+            print(json.dumps(result, ensure_ascii=False, indent=2))
+            if len(sys.argv) > 1:
+                Path(sys.argv[1]).parent.mkdir(parents=True, exist_ok=True)
+                Path(sys.argv[1]).write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+            await browser.close()
+
+if __name__ == '__main__':
+    asyncio.run(main())
