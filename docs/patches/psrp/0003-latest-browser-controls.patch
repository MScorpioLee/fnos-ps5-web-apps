+import { useEffect, useState } from 'react'
+import type { StreamDiagnostics, BufferDisplayResult } from '@/hooks/use-streaming-connection'
+import type { BufferMode } from '@/utils/streaming-diagnostics'
+
+const value = (n: number | null | undefined, unit = '') => n == null || !Number.isFinite(n) ? '不可用' : `${n.toFixed(1)}${unit}`
+const statuses = { applied: '已写入并读回', restored: '已还原', unsupported: '不支持', rejected: '写入/还原被拒绝' }
+export function StreamingDiagnosticsPanel({ snapshot: s, bufferMode, bufferResults = [], onBufferMode }: {
+  snapshot: StreamDiagnostics | null; bufferMode: BufferMode; bufferResults: BufferDisplayResult[]; onBufferMode: (mode: BufferMode) => void
+}) {
+  const [now, setNow] = useState(Date.now())
+  const [hidden, setHidden] = useState(document.hidden)
+  useEffect(() => {
+    // UI age clock only. No stats/transport polling; the hook owns the sole 2s getStats loop.
+    const timer = window.setInterval(() => setNow(Date.now()), 1000)
+    const visibility = () => setHidden(document.hidden)
+    document.addEventListener('visibilitychange', visibility)
+    return () => { window.clearInterval(timer); document.removeEventListener('visibilitychange', visibility) }
+  }, [])
+  const stale = !s || now - s.updatedAt > 6000 || hidden
+  const measured = stale ? null : s
+  return <details aria-label="串流诊断" style={{ position: 'fixed', top: 54, left: 8, zIndex: 160, maxWidth: 'min(510px, calc(100vw - 16px))', maxHeight: 'calc(100dvh - 120px)', overflow: 'auto', padding: 8, borderRadius: 8, background: 'rgba(0,0,0,.85)', color: 'white', fontSize: 12, pointerEvents: 'auto' }}>
+    <summary style={{ cursor: 'pointer' }}>实时串流诊断 · {bufferMode === 'low-latency' ? '低延迟（实验性）' : '自动'}{stale ? ' · 测量不可用' : ''}</summary>
+    <p>目标（非实测）：1920×1080 / 60 FPS · 源采集 FPS：不可用</p>
+    <p>更新时间：{s ? `${Math.max(0, (now - s.updatedAt) / 1000).toFixed(1)} 秒前` : '不可用'} · {hidden ? '页面隐藏，测量不可用' : stale ? '无数据或已过期' : s?.intervalState === 'baseline' || s?.intervalState === 'reset' ? '首帧/重置，等待下一窗口' : '近期约 2 秒窗口'}</p>
+    <p>接收 receive FPS：{value(measured?.reportedReceiveFps)} · 解码 decode FPS：{value(measured?.decodeFps)} · 呈现 present FPS：{value(measured?.presentFps)}</p>
+    <p>呈现是合成器回调，非物理屏幕 Hz。{s?.presentationSupport === 'decode-only' && '此浏览器仅支持解码统计，呈现 FPS 不可用。'}</p>
+    <p>近期平均 decode：{value(measured?.avgDecodeMs, ' ms')} · jitter 缓冲停留：{value(measured?.jitterBufferMs, ' ms')}</p>
+    <p>近期 drop：{value(measured?.framesDropped)} · 净 loss：{value(measured?.packetsLost)} · 恢复修正：{value(measured?.packetsRecovered)}</p>
+    <p>近期 freeze：{value(measured?.freezeCount)} / {value(measured?.freezeDurationMs, ' ms')} · PLI/NACK/FIR：{value(measured?.pliCount)} / {value(measured?.nackCount)} / {value(measured?.firCount)}</p>
+    <p>Codec：{measured?.codec ?? '不可用'} · 解码实现：{measured?.decoder ?? '不可用'} · 实际接收：{measured?.resolution ? `${measured.resolution.width}×${measured.resolution.height}` : '不可用'}</p>
+    <p>RTT 网络往返：{value(measured?.rttMs, ' ms')}（非端到端总延迟）</p>
+    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+      <button type="button" style={{ minHeight: 44, padding: '6px 10px', border: '1px solid #aaa', borderRadius: 6, background: bufferMode === 'auto' ? '#334155' : '#111' }} aria-pressed={bufferMode === 'auto'} onClick={() => onBufferMode('auto')}>自动（保持/还原原值）</button>
+      <button type="button" style={{ minHeight: 44, padding: '6px 10px', border: '1px solid #aaa', borderRadius: 6, background: bufferMode === 'low-latency' ? '#334155' : '#111' }} aria-pressed={bufferMode === 'low-latency'} onClick={() => onBufferMode('low-latency')}>低延迟（实验性）</button>
+    </div>
+    <p>只对 video 设置受支持的浏览器提示，不保证零缓冲或降低总延迟；音频不变。不转码、不超分、不自动降分辨率。</p>
+    {bufferResults.map((r, i) => <p key={`${r.receiverIndex}-${r.property}-${i}`}>video #{r.receiverIndex} {r.property} ({r.unit})：{statuses[r.status]} · 读回 {r.readback === null ? 'null' : r.readback ?? '不可用'}</p>)}
+  </details>
+}
