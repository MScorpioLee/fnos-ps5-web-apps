+export type DiagnosticSnapshot = ReturnType<StreamingDiagnostics['sample']>;
+export type DiagnosticsClock = { setInterval(callback: () => void, ms: number): unknown; clearInterval(handle: unknown): void };
+/** Optional standalone poller. Prefer sample(report) in an existing 2s stats loop to avoid duplicate getStats work. */
+export function startDiagnosticsPolling(
+  source: { getStats(): Promise<Stats> },
+  onSample: (sample: DiagnosticSnapshot) => void,
+  onError: (error: unknown) => void,
+  clock: DiagnosticsClock = {
+    setInterval: (fn, ms) => globalThis.setInterval(fn, ms),
+    clearInterval: handle => globalThis.clearInterval(handle as ReturnType<typeof setInterval>),
+  },
+) {
+  const diagnostics = new StreamingDiagnostics();
+  let stopped = false, busy = false;
+  const handle = clock.setInterval(() => {
+    if (stopped || busy) return;
+    busy = true;
+    void (async () => {
+      try {
+        const report = await source.getStats();
+        if (!stopped) onSample(diagnostics.sample(report));
+      } catch (error) {
+        diagnostics.reset();
+        if (!stopped) onError(error);
+      } finally { busy = false; }
+    })();
+  }, 2000);
+  return () => { stopped = true; clock.clearInterval(handle); diagnostics.reset(); };
