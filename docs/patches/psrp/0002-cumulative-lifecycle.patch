+using System.Collections.Concurrent;
+using RemotePlay.Models.PlayStation;
+
+namespace RemotePlay.Services.Lifecycle;
+
+/// <summary>All state transitions run under Sync; async callers also hold HostGate across I/O.</summary>
+public sealed class SessionLifecycle(TimeProvider? clock = null)
+{
+    readonly TimeProvider time = clock ?? TimeProvider.System;
+    readonly ConcurrentDictionary<Guid, Entry> entries = new();
+    readonly ConcurrentDictionary<string, SemaphoreSlim> gates = new();
+    public TimeSpan Grace { get; set; } = TimeSpan.FromSeconds(60);
+    public SemaphoreSlim HostGate(string host) => gates.GetOrAdd(host, _ => new(1, 1));
+    public sealed record LeaseResult(int Status, long Generation, string? Token = null);
+    public sealed class Entry(RemoteSession session, string owner, DateTimeOffset now)
+    {
+        public readonly object Sync = new();
+        public RemoteSession Session { get; } = session;
+        public string Owner { get; } = owner;
+        public long Generation;
+        public string? Pending, Current;
+        public DateTimeOffset PendingUntil, IdleSince = now;
+        public readonly HashSet<string> Connected = new();
+        public readonly Dictionary<string, string> Browsers = new();
+        public bool Closing;
+    }
+    public Entry? Find(Guid id) => entries.GetValueOrDefault(id);
+    public Entry? FindHost(string host) => entries.Values.FirstOrDefault(e => e.Session.HostId == host && !e.Closing && e.Session.IsActive);
+    public void Register(RemoteSession s, string owner)
+    {
+        if (string.IsNullOrEmpty(owner)) throw new ArgumentException("Owner required");
+        if (!entries.TryAdd(s.Id, new(s, owner, time.GetUtcNow()))) throw new InvalidOperationException("Already registered");
+    }
+    public LeaseResult Prepare(Guid id, string owner, long? confirmedGeneration)
+    {
+        var e = Find(id);
+        if (e == null) return new(403, 0);
+        lock (e.Sync)
+        {
+            if (e.Closing || !e.Session.IsActive || string.IsNullOrEmpty(owner) || e.Owner != owner) return new(403, 0);
+            if (e.Generation != 0 && confirmedGeneration != e.Generation) return new(409, e.Generation);
+            e.Pending = Guid.NewGuid().ToString("N");
+            e.PendingUntil = time.GetUtcNow() + Grace;
+            return new(200, ++e.Generation, e.Pending);
+        }
+    }
+    public bool Allows(Guid id, string owner, string token, bool currentOnly = false)
+    {
+        var e = Find(id); if (e == null || string.IsNullOrEmpty(token)) return false;
+        lock (e.Sync) return !e.Closing && e.Session.IsActive && owner == e.Owner &&
+            (e.Current == token || (!currentOnly && e.Pending == token && time.GetUtcNow() < e.PendingUntil));
+    }
+    public bool IsCurrent(Guid id, string owner, string token) => Allows(id, owner, token, true);
+    public bool Bind(Guid id, string owner, string token, string browser)
+    {
+        var e = Find(id); if (e == null) return false;
+        lock (e.Sync)
+        {
+            if (!Allows(id, owner, token)) return false;
+            // One peer per lease: duplicate offers must use a new prepare/confirmation.
+            if (e.Browsers.TryGetValue(token, out var old) && old != browser) return false;
+            e.Browsers[token] = browser; return true;
+        }
+    }
+    public bool OwnsBrowser(Guid id, string owner, string token, string browser)
+    {
+        var e = Find(id); if (e == null) return false;
+        lock (e.Sync) return Allows(id, owner, token) && e.Browsers.GetValueOrDefault(token) == browser;
+    }
+    public void SetConnected(Guid id, string token, bool connected)
+    {
+        var e = Find(id); if (e == null) return;
+        lock (e.Sync)
+        {
+            if (connected && (e.Current == token || e.Pending == token)) e.Connected.Add(token);
+            else if (e.Connected.Remove(token) && e.Current == token) e.IdleSince = time.GetUtcNow();
+        }
+    }
+    public bool Commit(Guid id, string owner, string token)
+    {
+        var e = Find(id); if (e == null) return false;
+        lock (e.Sync)
+        {
+            if (!Allows(id, owner, token) || !e.Connected.Contains(token)) return false;
+            if (e.Current == token) return true;
+            if (e.Pending != token) return false;
+            e.Current = token; e.Pending = null;
+            return true;
+        }
+    }
+    public void Release(Guid id, string token)
+    {
+        var e = Find(id); if (e == null) return;
+        lock (e.Sync)
+        {
+            e.Connected.Remove(token); e.Browsers.Remove(token);
+            if (e.Current == token) { e.Current = null; e.IdleSince = time.GetUtcNow(); }
+            if (e.Pending == token) e.Pending = null;
+        }
+    }
+    public bool Expired(Guid id)
+    {
+        var e = Find(id); if (e == null) return false;
+        lock (e.Sync) return !e.Closing && (e.Current == null || !e.Connected.Contains(e.Current)) && time.GetUtcNow() - e.IdleSince >= Grace;
+    }
+    public Entry[] Entries => entries.Values.ToArray();
+    public void Forget(Guid id) => entries.TryRemove(id, out _);
+}
