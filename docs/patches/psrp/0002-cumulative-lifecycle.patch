+static class ReceiverAtomicityTests
+{
+    static object? Get(object target,string name) => target.GetType().GetField(name,BindingFlags.Instance|BindingFlags.NonPublic)!.GetValue(target);
+    static void Set(object target,string name,object value) => target.GetType().GetField(name,BindingFlags.Instance|BindingFlags.NonPublic)!.SetValue(target,value);
+    public static Task Pipeline() => Exercise(true);
+    public static Task Legacy() => Exercise(false);
+    static async Task Exercise(bool pipelineMode)
+    {
+        using var pause=new ReceiverRoutePause();
+        using var stream=new RPStreamV2(NullLogger<RPStreamV2>.Instance,NullLoggerFactory.Instance,new RemoteSession{HostId="fixture"},"127.0.0.1",9296,default);
+        var a=new RecordingReceiver();var b=new RecordingReceiver();
+        Set(stream,"_usePipeline",pipelineMode);
+        // Real routing objects, no console transport or test hooks in production code.
+        using var pipeline=new AVPipelineCoordinator(NullLogger<AVPipelineCoordinator>.Instance,NullLoggerFactory.Instance,"PS5",a,default);
+        var output=(OutputPipeline)Get(pipeline,"_outputPipeline")!;
+        var handler=new AVHandler(NullLogger<AVHandler>.Instance,"PS5",null,a,default);
+        if(pipelineMode) { Set(stream,"_avPipeline",pipeline);Set(output,"_logger",pause); }
+        else { Set(stream,"_avHandler",handler);Set(handler,"_logger",pause); }
+        Set(stream,"_receiver",a);
+        Exception? removeError=null,addError=null;
+        using var addStarted=new ManualResetEventSlim();using var addFinished=new ManualResetEventSlim();
+        var remove=new Thread(()=>{try {stream.RemoveReceiver(a);}catch(Exception ex){removeError=ex;}}){IsBackground=true};
+        var add=new Thread(()=>{addStarted.Set();try {stream.AddReceiver(b);}catch(Exception ex){addError=ex;}finally {addFinished.Set();}}){IsBackground=true};
+        bool overlapped=false;
+        try
+        {
+            remove.Start();
+            if(!pause.Entered.Wait(3000))throw new Exception("remove did not enter real receiver routing update");
+            add.Start();if(!addStarted.Wait(3000))throw new Exception("add worker did not start");
+            // The dedicated worker either completes (old bug) or blocks on the shared monitor.
+            // No sleep-based scheduling or probabilistic stress is needed.
+            if(!SpinWait.SpinUntil(()=>addFinished.IsSet || (add.ThreadState & ThreadState.WaitSleepJoin)!=0,3000))throw new Exception("add worker neither completed nor blocked");
+            overlapped=addFinished.IsSet;
+        }
+        finally {pause.Continue.Set();remove.Join(3000);if(add.ThreadState!=ThreadState.Unstarted)add.Join(3000);}
+        if(removeError!=null || addError!=null)throw new Exception("receiver worker failed",removeError??addError);
+        if(!ReferenceEquals(Get(stream,"_receiver"),b))throw new Exception("receiver reference is not B");
+        if(pipelineMode)
+        {
+            if(!ReferenceEquals(Get(pipeline,"_receiver"),b) || !ReferenceEquals(Get(output,"_receiver"),b))throw new Exception("real pipeline route is not B");
+            output.TryPushAudioFrame(new ProcessedFrame{Data=new byte[]{1,2,3}});
+            await b.Audio.Task.WaitAsync(TimeSpan.FromSeconds(3));
+            if(a.Packets!=0 || b.Packets!=1)throw new Exception("actual output media was not delivered exclusively to B");
+        }
+        else
+        {
+            if(!ReferenceEquals(Get(handler,"_receiver"),b))throw new Exception("real AVHandler media route is not B");
+            Set(handler,"_audioReceiver",new AudioReceiver());
+            // Six real parsed audio packets fill the legacy jitter buffer and exercise
+            // AVHandler.ProcessSinglePacket -> AudioReceiver -> current receiver callback.
+            for(ushort i=0;i<6;i++)
+            {
+                var raw=new byte[23];raw[0]=(byte)RemotePlay.Services.Streaming.Protocol.HeaderType.AUDIO;
+                System.Buffers.Binary.BinaryPrimitives.WriteUInt16BigEndian(raw.AsSpan(3,2),i);
+                System.Buffers.Binary.BinaryPrimitives.WriteUInt32BigEndian(raw.AsSpan(5,4),0x0301);
+                raw[20]=1;raw[21]=2;raw[22]=3;
+                if(!AVPacket.TryParse(raw,"PS5",out var packet))throw new Exception("audio fixture parse failed");
+                typeof(AVHandler).GetMethod("ProcessSinglePacket",BindingFlags.NonPublic|BindingFlags.Instance)!.Invoke(handler,new object[]{packet});
+            }
+            if(a.Packets!=0 || b.Packets!=6)throw new Exception("actual legacy audio was not delivered exclusively to B");
+        }
+        stream.RemoveReceiver(a); // A's later disconnect must remain harmless.
+        if(!ReferenceEquals(Get(stream,"_receiver"),b))throw new Exception("stale A removed installed B");
+        Console.WriteLine($"receiver mode={(pipelineMode?"pipeline":"legacy")} addOverlappedRemoval={overlapped} reference=B realRoute=B A.audio={a.Packets} B.audio={b.Packets}");
+        if(overlapped)throw new Exception("B installed while A was still inside receiver routing update: check/reference/route are not atomic");
+    }
+    sealed class RecordingReceiver : IAVReceiver
+    {
+        public int Packets;public TaskCompletionSource Audio=new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public void OnAudioPacket(byte[] packet){Interlocked.Increment(ref Packets);Audio.TrySetResult();}
+        public void OnVideoPacket(byte[] packet) { }
+        public void OnStreamInfo(byte[] videoHeader,byte[] audioHeader) { }
+        public void SetVideoCodec(string codec) { }
+        public void SetAudioCodec(string codec) { }
+        public void EnterWaitForIdr() { }
+    }
+    // Pause an existing logger call INSIDE the real SetReceiver, only when installing the sink.
+    // This proves the boundary covers routing, rather than just a CAS on _receiver.
+    sealed class ReceiverRoutePause : ILogger<OutputPipeline>,ILogger<AVHandler>,IDisposable
+    {
+        public readonly ManualResetEventSlim Entered=new(),Continue=new();
+        public IDisposable? BeginScope<TState>(TState state) where TState:notnull => null;
+        public bool IsEnabled(LogLevel level)=>true;
+        public void Log<TState>(LogLevel level,EventId id,TState state,Exception? exception,Func<TState,Exception?,string> formatter)
+        {
+            if(formatter(state,exception).Contains("-> DefaultReceiver") || formatter(state,exception).Contains("to DefaultReceiver"))
+            {Entered.Set();if(!Continue.Wait(5000))throw new Exception("routing pause timed out");}
+        }
+        public void Dispose(){Entered.Dispose();Continue.Dispose();}
+    }
+}
