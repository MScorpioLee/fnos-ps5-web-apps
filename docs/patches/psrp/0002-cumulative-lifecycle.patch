+static class BrowserLifetimeTests
+{
+    public static async Task RemovalKeepsConsole()
+    {
+        var proxy = DispatchProxy.Create<IStreamingService, StopCountingProxy>();
+        var services = new ServiceCollection().BuildServiceProvider();
+        var signaling = new WebRTCSignalingService(NullLogger<WebRTCSignalingService>.Instance, NullLoggerFactory.Instance, streamingService: proxy, serviceProvider: services);
+        using var peer = new RTCPeerConnection(new RTCConfiguration { iceServers = new() });
+        using var receiver = new WebRTCReceiver("browser", peer, NullLogger<WebRTCReceiver>.Instance);
+        var rtc = new WebRTCSession { SessionId = "browser", PeerConnection = peer, Receiver = receiver, StreamingSessionId = Guid.NewGuid() };
+        ((ConcurrentDictionary<string, WebRTCSession>)typeof(WebRTCSignalingService).GetField("_sessions", BindingFlags.NonPublic | BindingFlags.Instance)!.GetValue(signaling)!)["browser"] = rtc;
+        await signaling.RemoveSessionAsync("browser");
+        if (((StopCountingProxy)(object)proxy).Stops != 0) throw new Exception("Browser deletion immediately stopped PS5 instead of independent idle grace");
+    }
+}
+public class StopCountingProxy : DispatchProxy
+{
+    public int Stops;
+    protected override object? Invoke(MethodInfo? method, object?[]? args)
+    {
+        if (method!.Name == "StopStreamAsync") { Stops++; return Task.FromResult(true); }
+        if (method.Name == "GetStreamAsync") return Task.FromResult<RemotePlay.Services.Streaming.Core.RPStreamV2?>(null);
+        throw new NotSupportedException(method.Name);
+    }
+}
