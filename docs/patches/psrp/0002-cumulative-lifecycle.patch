+using RemotePlay.Contracts.Services;
+using RemotePlay.Services.WebRTC;
+
+namespace RemotePlay.Services.Lifecycle;
+
+public sealed class LifecycleReaper(SessionLifecycle lifecycle, ISessionService sessions, IStreamingService streams, WebRTCSignalingService rtc, ILogger<LifecycleReaper> log, IServiceScopeFactory scopes) : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
+        // Each host retains its gate while cleaning up; a slow host cannot stall later ticks.
+        while (await timer.WaitForNextTickAsync(stoppingToken)) _ = SweepAsync(stoppingToken);
+    }
+    public Task SweepAsync(CancellationToken stoppingToken = default) =>
+        Task.WhenAll(lifecycle.Entries.Select(e => ReapAsync(e, stoppingToken)));
+    async Task ReapAsync(SessionLifecycle.Entry e, CancellationToken stoppingToken)
+    {
+            var gate = lifecycle.HostGate(e.Session.HostId);
+            if (!await gate.WaitAsync(0, stoppingToken)) return;
+            try
+            {
+                using var scope = scopes.CreateScope();
+                if ((e.Current != null || e.Pending != null) &&
+                    !await scope.ServiceProvider.GetRequiredService<LifecycleAccess>().DeviceAllowed(e.Owner, e.Session.HostId, stoppingToken))
+                {
+                    string? current, pending;
+                    lock (e.Sync) { current = e.Current; pending = e.Pending; }
+                    if (current != null) lifecycle.Release(e.Session.Id, current);
+                    if (pending != null) lifecycle.Release(e.Session.Id, pending);
+                }
+                foreach (var browser in rtc.GetAllSessions().Where(b => b.StreamingSessionId == e.Session.Id).ToArray())
+                    if (!lifecycle.Allows(e.Session.Id, browser.OwnerId, browser.LifecycleToken)) await rtc.RemoveSessionAsync(browser.SessionId);
+                if (e.Closing || lifecycle.Expired(e.Session.Id) || !e.Session.IsActive)
+                {
+                    lock (e.Sync) e.Closing = true;
+                    // A failed media shutdown must never leave console TCP unbounded.
+                    try { await streams.StopStreamAsync(e.Session.Id); }
+                    finally { await sessions.StopSessionAsync(e.Session.Id); }
+                    foreach (var browser in rtc.GetAllSessions().Where(b => b.StreamingSessionId == e.Session.Id).ToArray()) await rtc.RemoveSessionAsync(browser.SessionId);
+                    lifecycle.Forget(e.Session.Id);
+                }
+            }
+            catch (Exception ex) { log.LogError(ex, "Lifecycle cleanup failed; retrying next sweep"); }
+            finally { gate.Release(); }
+    }
+}
