+using System.Security.Claims;
+using RemotePlay.Contracts.Services;
+using RemotePlay.Services.Streaming.Controller;
+
+namespace RemotePlay.Services.Lifecycle;
+
+/// <summary>Tap waits never hold HostGate; each state mutation revalidates the current lease.</summary>
+public static class LifecycleButton
+{
+    public static async Task SendAsync(IServiceProvider services, ClaimsPrincipal user, string token,
+        Guid id, FeedbackEvent.ButtonType button, IControllerService.ButtonAction action, int delayMs, CancellationToken ct)
+    {
+        if (action == IControllerService.ButtonAction.TAP && (delayMs < 0 || delayMs > 1000))
+            throw new ArgumentOutOfRangeException(nameof(delayMs), "Tap duration must be between 0 and 1000 ms");
+        var life = services.GetRequiredService<SessionLifecycle>();
+        if (life.Find(id) is not { } entry) throw new UnauthorizedAccessException("会话不可用或无权访问");
+        var gate = life.HostGate(entry.Session.HostId);
+        async Task Send(IControllerService.ButtonAction state, CancellationToken cancellation, bool required)
+        {
+            await gate.WaitAsync(cancellation);
+            try
+            {
+                using var scope = services.CreateScope();
+                if (!await scope.ServiceProvider.GetRequiredService<LifecycleAccess>().Allowed(user, id, token, true))
+                {
+                    if (required) throw new UnauthorizedAccessException("会话不可用或无权访问");
+                    return; // Never release a button on a replacement controller's lease.
+                }
+                await services.GetRequiredService<IControllerService>().ButtonAsync(id, button, state, 0, cancellation);
+            }
+            finally { gate.Release(); }
+        }
+        if (action != IControllerService.ButtonAction.TAP) { await Send(action, ct, true); return; }
+        await Send(IControllerService.ButtonAction.PRESS, ct, true);
+        try { await Task.Delay(delayMs, ct); }
+        finally { await Send(IControllerService.ButtonAction.RELEASE, CancellationToken.None, false); }
+    }
+}
