+using Microsoft.AspNetCore.SignalR;
+using RemotePlay.Hubs;
+
+namespace RemotePlay.Services.Lifecycle;
+
+public sealed class LifecycleHubFilter(SessionLifecycle lifecycle, IServiceScopeFactory scopes, global::RemotePlay.Services.WebRTC.WebRTCSignalingService signaling) : IHubFilter
+{
+    public async ValueTask<object?> InvokeMethodAsync(HubInvocationContext ctx, Func<HubInvocationContext, ValueTask<object?>> next)
+    {
+        if (ctx.Hub is not ControllerHub && ctx.Hub is not StreamingHub) return await next(ctx);
+        Guid id;
+        string? browser = null;
+        if (ctx.Hub is StreamingHub)
+        {
+            browser = ctx.HubMethodArguments.FirstOrDefault()?.ToString();
+            var rtc = browser == null ? null : signaling.GetSession(browser);
+            if (rtc?.StreamingSessionId == null) throw new HubException("会话不可用或无权访问");
+            id = rtc.StreamingSessionId.Value;
+        }
+        else if (ctx.HubMethodArguments.FirstOrDefault() is Guid remoteId) id = remoteId;
+        else throw new HubException("会话不可用或无权访问");
+        if (lifecycle.Find(id) is not { } e) throw new HubException("会话不可用或无权访问");
+        var token = ctx.Context.GetHttpContext()?.Request.Query["lease"].ToString() ?? "";
+        var gate = lifecycle.HostGate(e.Session.HostId); await gate.WaitAsync(ctx.Context.ConnectionAborted);
+        bool gateHeld = true;
+        try
+        {
+            using var scope = scopes.CreateScope();
+            if (!await scope.ServiceProvider.GetRequiredService<LifecycleAccess>().Allowed(ctx.Context.User!, id, token, ctx.Hub is ControllerHub) ||
+                (browser != null && !lifecycle.OwnsBrowser(id, LifecycleAccess.Owner(ctx.Context.User!), token, browser)))
+                throw new HubException("会话不可用或无权访问");
+            if (ctx.HubMethodName is "DisconnectController" or "StopController") return null;
+            if (ctx.Hub is ControllerHub && ctx.HubMethodName == "Button") { gate.Release(); gateHeld = false; }
+            return await next(ctx);
+        }
+        finally { if (gateHeld) gate.Release(); }
+    }
+}
