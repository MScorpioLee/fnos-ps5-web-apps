+// Memory-only and page-scoped: never share browser-controller leases across tabs.
+let lease = ''
+const resources = new Map<string, string>()
+export const currentLease = () => lease
+export function rememberLease(id: string, token: string, activate = true) { if (activate) lease = token; resources.set(id, token) }
+export function resourceLease(endpoint: string, body?: BodyInit | null): string {
+  const text = endpoint + (typeof body === 'string' ? body : '')
+  for (const [id, token] of resources) if (text.includes(id)) return token
+  return lease
+}
