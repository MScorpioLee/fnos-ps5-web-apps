+using Microsoft.AspNetCore.Authorization;
+using RemotePlay.Controllers;
+using RemotePlay.Hubs;
+using RemotePlay.Services.Lifecycle;
+using RemotePlay.Models.PlayStation;
+
+static class LifecycleBoundaryTests
+{
+    static void Check(bool v, string m) { if (!v) throw new Exception(m); }
+    public static Task AuthBoundaries()
+    {
+        foreach (var type in new[] { typeof(WebRTCController), typeof(PlayStationController), typeof(StreamingController), typeof(ControllerHub), typeof(StreamingHub) })
+            Check(type.GetCustomAttributes(typeof(AuthorizeAttribute), true).Length > 0, $"{type.Name} allows anonymous lifecycle/control");
+        return Task.CompletedTask;
+    }
+    public static Task ClockBoundaries()
+    {
+        var clock = new ManualClock(); var c = new SessionLifecycle(clock);
+        var s = new RemoteSession { HostId = "ps5" }; c.Register(s,"alice");
+        var a = c.Prepare(s.Id,"alice",null);
+        clock.Advance(59); Check(!c.Expired(s.Id), "initial lease expires before 60s");
+        clock.Advance(1); Check(c.Expired(s.Id), "unconnected offers leaked beyond 60s");
+        s = new RemoteSession { HostId = "other" }; c.Register(s,"alice");
+        a = c.Prepare(s.Id,"alice",null); c.SetConnected(s.Id,a.Token!,true); c.Commit(s.Id,"alice",a.Token!);
+        c.SetConnected(s.Id,a.Token!,false); clock.Advance(59);
+        c.SetConnected(s.Id,a.Token!,true); clock.Advance(1); Check(!c.Expired(s.Id), "59s reconnect failed to rescue console");
+        c.SetConnected(s.Id,a.Token!,false); clock.Advance(59);
+        c.SetConnected(s.Id,a.Token!,false); clock.Advance(1);
+        Check(c.Expired(s.Id), "duplicate old disconnected callback extended grace");
+        s = new RemoteSession { HostId = "replacement" }; c.Register(s,"alice");
+        a = c.Prepare(s.Id,"alice",null); c.SetConnected(s.Id,a.Token!,true); c.Commit(s.Id,"alice",a.Token!);
+        c.Release(s.Id,a.Token!); clock.Advance(59);
+        var conflict = c.Prepare(s.Id,"alice",null);
+        Check(conflict.Status == 409, "new browser skipped confirmation during grace");
+        var replacement = c.Prepare(s.Id,"alice",conflict.Generation);
+        c.SetConnected(s.Id,replacement.Token!,true);
+        Check(c.Commit(s.Id,"alice",replacement.Token!), "59s replacement could not commit");
+        clock.Advance(1); Check(!c.Expired(s.Id), "released-browser replacement did not rescue console at 59s");
+        var pending = c.Prepare(s.Id,"alice",replacement.Generation);
+        clock.Advance(60); c.SetConnected(s.Id,pending.Token!,true);
+        Check(!c.Commit(s.Id,"alice",pending.Token!), "expired pending lease was revived by a late connected callback");
+        Check(c.IsCurrent(s.Id,"alice",replacement.Token!), "expired pending lease disturbed the active controller");
+        return Task.CompletedTask;
+    }
+}
+sealed class ManualClock : TimeProvider
+{
+    DateTimeOffset now = DateTimeOffset.UnixEpoch;
+    public override DateTimeOffset GetUtcNow() => now;
+    public void Advance(int seconds) => now += TimeSpan.FromSeconds(seconds);
+}
