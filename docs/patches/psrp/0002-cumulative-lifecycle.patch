+import asyncio, json, os
+from pathlib import Path
+from playwright.async_api import async_playwright
+
+async def main():
+    async with async_playwright() as p:
+        browser = await p.chromium.launch(executable_path=__import__('os').environ.get('CHROMIUM_PATH'), headless=True, args=['--no-sandbox'])
+        results=[]
+        for accepted in [False, True]:
+            page=await browser.new_page()
+            requests=[]; dialogs=[]
+            async def route(r):
+                requests.append(r.request.url)
+                if 'confirmedGeneration=7' in r.request.url:
+                    await r.fulfill(status=200,json={'success':True,'data':{'id':'remote','hostId':'ps5','token':'lease-B','generation':8}})
+                else:
+                    await r.fulfill(status=409,json={'success':False,'generation':7,'errorMessage':'此 PS5 已有会话。确认接管？取消不影响原连接。'})
+            async def dialog(d):
