+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Filters;
+using RemotePlay.Controllers;
+using RemotePlay.Services.WebRTC;
+
+namespace RemotePlay.Services.Lifecycle;
+
+/// <summary>Fail-closed gate for every session-bearing HTTP action, including diagnostics and input.</summary>
+public sealed class LifecycleFilter(SessionLifecycle lifecycle, LifecycleAccess access, WebRTCSignalingService signaling) : IAsyncActionFilter
+{
+    static ObjectResult Denied(int status = 403) => new(new { success = false, errorMessage = "会话不可用或无权访问" }) { StatusCode = status };
+    public async Task OnActionExecutionAsync(ActionExecutingContext ctx, ActionExecutionDelegate next)
+    {
+        var controller = ctx.Controller;
+        if (controller is not PlayStationController && controller is not WebRTCController && controller is not StreamingController) { await next(); return; }
+        var args = ctx.ActionArguments;
+        var owner = LifecycleAccess.Owner(ctx.HttpContext.User);
+        string token = ctx.HttpContext.Request.Headers["X-PSRP-Lease"].ToString();
+        if (args.TryGetValue("hostId", out var hostArg) && ctx.ActionDescriptor.RouteValues["action"] is "StartSession" or "WakeUpConsole")
+        {
+            if (string.IsNullOrEmpty(owner)) { ctx.Result = Denied(401); return; }
+            var host = hostArg?.ToString() ?? "";
+            if (!await access.DeviceAllowed(owner, host)) { ctx.Result = Denied(); return; }
+            var gate = lifecycle.HostGate(host); await gate.WaitAsync(ctx.HttpContext.RequestAborted);
+            try { await next(); } finally { gate.Release(); }
+            return;
+        }
+        string? session = (args.TryGetValue("sessionId", out var sessionIdArg) ? sessionIdArg?.ToString() : null);
+        string? remote = (args.TryGetValue("remotePlaySessionId", out var remotePlaySessionIdArg) ? remotePlaySessionIdArg?.ToString() : null);
+        var browser = (args.TryGetValue("webrtcSessionId", out var webrtcSessionIdArg) ? webrtcSessionIdArg?.ToString() : null);
+        foreach (var arg in args.Values.Where(x => x != null))
+        {
+            remote ??= arg!.GetType().GetProperty("RemotePlaySessionId")?.GetValue(arg)?.ToString();
+            session ??= arg!.GetType().GetProperty("SessionId")?.GetValue(arg)?.ToString();
+        }
+        if (controller is WebRTCController)
+        {
+            browser ??= session;
+            if (browser != null)
+            {
+                var rtc = signaling.GetSession(browser);
+                if (rtc == null || rtc.OwnerId != owner || rtc.LifecycleToken != token || rtc.StreamingSessionId == null ||
+                    (remote != null && remote != rtc.StreamingSessionId.ToString())) { ctx.Result = Denied(); return; }
+                remote = rtc.StreamingSessionId.ToString();
+            }
+            if (remote == null) { ctx.Result = Denied(); return; } // no global session enumeration or unbound offers
+        }
+        else remote ??= session;
+        if (remote == null) { await next(); return; } // non-lifecycle settings/device APIs retain their existing auth
+        if (string.IsNullOrEmpty(owner)) { ctx.Result = Denied(401); return; }
+        if (!Guid.TryParse(remote, out var id) || lifecycle.Find(id) is not { } entry) { ctx.Result = Denied(); return; }
+        var hostGate = lifecycle.HostGate(entry.Session.HostId); await hostGate.WaitAsync(ctx.HttpContext.RequestAborted);
+        bool gateHeld = true;
+        try
+        {
+            var action = ctx.ActionDescriptor.RouteValues["action"] ?? "";
+            bool currentOnly = controller is not WebRTCController && action != "StartStream" && action != "GetStreamHealth" && action != "GetSession";
+            if (!await access.Allowed(ctx.HttpContext.User, id, token, currentOnly) ||
+                (browser != null && !lifecycle.OwnsBrowser(id, owner, token, browser))) { ctx.Result = Denied(); return; }
+            // Legacy endpoints cannot implicitly stop a shared console/controller or change its stream.
+            if (action is "StopStream" or "DisconnectController" or "StopController" or "AttachReceiver" or "AttachFileReceiver" or "AttachFfplayReceiver" or "AttachFfmpegReceiver" or "ShareHls")
+            { ctx.Result = Denied(); return; }
+            if (action == "ControllerButton") { hostGate.Release(); gateHeld = false; }
+            await next();
+        }
+        finally { if (gateHeld) hostGate.Release(); }
+    }
+}
