+using RemotePlay.Services.WebRTC;
+using RemotePlay.Services.Lifecycle;
+using RemotePlay.Models.PlayStation;
+
+static class LifecycleTests
+{
+    static void Check(bool v, string m) { if (!v) throw new Exception(m); }
+    public static Task Exists()
+    {
+        if (typeof(WebRTCSignalingService).Assembly.GetType("RemotePlay.Services.Lifecycle.SessionLifecycle") == null)
+            throw new Exception("Missing owner-bound lifecycle coordinator");
+        return Task.CompletedTask;
+    }
+    public static Task OwnerAndTakeover()
+    {
+        dynamic c = new SessionLifecycle();
+        var s = new RemoteSession { HostId = "ps5" };
+        c.Register(s, "alice");
+        dynamic a = c.Prepare(s.Id, "alice", (long?)null);
+        Check(a.Status == 200, "initial lease");
+        c.SetConnected(s.Id, (string)a.Token, true);
+        Check(c.Commit(s.Id, "alice", (string)a.Token), "A commit");
+        Check(c.Prepare(s.Id, "bob", (long?)1).Status == 403, "cross-owner forbidden");
+        Check(c.Prepare(s.Id, "", (long?)null).Status == 403, "anonymous forbidden");
+        dynamic conflict = c.Prepare(s.Id, "alice", (long?)null);
+        Check(conflict.Status == 409, "new page needs confirmation");
+        Check(c.IsCurrent(s.Id, "alice", (string)a.Token), "cancel does not mutate A");
+        dynamic b = c.Prepare(s.Id, "alice", (long?)conflict.Generation);
+        Check(b.Status == 200, "confirmed B prepared");
+        Check(c.IsCurrent(s.Id, "alice", (string)a.Token), "A retained until connected commit");
+        Check(!c.Commit(s.Id, "alice", (string)b.Token), "unconnected B cannot commit");
+        dynamic stale = c.Prepare(s.Id, "alice", (long?)conflict.Generation);
+        Check(stale.Status == 409, "CAS rejects stale generation");
+        dynamic latest = c.Prepare(s.Id, "alice", (long?)null);
+        dynamic third = c.Prepare(s.Id, "alice", (long?)latest.Generation);
+        c.SetConnected(s.Id, (string)b.Token, true);
+        Check(!c.Commit(s.Id, "alice", (string)b.Token), "superseded pending B cannot commit");
+        c.SetConnected(s.Id, (string)third.Token, true);
+        Check(c.Commit(s.Id, "alice", (string)third.Token), "C commits");
+        c.Release(s.Id, (string)a.Token);
+        Check(c.IsCurrent(s.Id, "alice", (string)third.Token), "late A delete cannot kill C");
+        return Task.CompletedTask;
+    }
+}
