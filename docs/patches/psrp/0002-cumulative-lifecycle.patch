+from http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler
+from pathlib import Path
+import json,sys
+ROOT=(Path(sys.argv[1]) if len(sys.argv)>1 else Path(__file__).resolve().parent/'www').resolve()
+class Handler(SimpleHTTPRequestHandler):
+    diagnostic_count=0
+    def translate_path(self,path):
+        path=path.split('?',1)[0]
+        prefix='/app/psrp-web/'
+        if path.startswith(prefix):path=path[len(prefix):]
+        candidate=(ROOT/path.lstrip('/')).resolve()
+        return str(candidate if candidate.is_relative_to(ROOT) else ROOT/'__denied__')
+    def do_GET(self):
+        if '/diagnostics/api/video.html' in self.path or '/api/cache-probe' in self.path:
+            Handler.diagnostic_count+=1
+            data=json.dumps({'network':True,'count':Handler.diagnostic_count}).encode()
+            self.send_response(200);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.end_headers();self.wfile.write(data);return
+        super().do_GET()
+    def log_message(self,format,*args):pass
+ThreadingHTTPServer(('127.0.0.1',5189),Handler).serve_forever()
